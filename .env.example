# DhanHQ API Credentials
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# (Optional) Telegram Bot for instant mobile alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert & Threshold Configuration
# Minimum volume (in contracts or shares) to qualify as a Whale Order
WHALE_VOLUME_THRESHOLD=50000

# Absorption price tolerance (points within which price stayed despite huge volume)
ABSORPTION_PRICE_POINTS=5.0

# Evaluation window in seconds to check if volume was absorbed, rejected, or broken out
EVALUATION_WINDOW_SECONDS=20
